{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freelance-ops-agent:builtin-skills:1.0.0",
  "title": "Freelance-Ops-Agent built-in skill catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "generated_on",
    "skill_count",
    "license",
    "cost_policy",
    "selection_defaults",
    "global_boundaries",
    "categories",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "freelance-ops-builtin-skills"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "skill_count": {
      "const": 60
    },
    "license": {
      "type": "object",
      "required": [
        "content",
        "third_party_templates_included"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "third_party_templates_included": {
          "const": false
        }
      }
    },
    "cost_policy": {
      "type": "object",
      "required": [
        "skill_access_price",
        "skill_access_currency",
        "requires_subscription_to_unlock_skills",
        "execution_billing_basis",
        "usage_display",
        "fixed_model_credit_cost",
        "additional_paid_api_dependency",
        "ui_ko",
        "ui_en"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_access_price": {
          "const": 0
        },
        "skill_access_currency": {
          "const": "USD"
        },
        "requires_subscription_to_unlock_skills": {
          "const": false
        },
        "execution_billing_basis": {
          "const": "actual_api_cost"
        },
        "usage_display": {
          "const": "weekly_limit_percentage"
        },
        "fixed_model_credit_cost": {
          "const": false
        },
        "additional_paid_api_dependency": {
          "const": false
        },
        "ui_ko": {
          "type": "string",
          "minLength": 1
        },
        "ui_en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selection_defaults": {
      "type": "object",
      "required": [
        "mode",
        "max_active_skills",
        "primary_count",
        "supporting_count_max",
        "load_full_catalog_into_model_context"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "auto"
        },
        "max_active_skills": {
          "const": 3
        },
        "primary_count": {
          "const": 1
        },
        "supporting_count_max": {
          "const": 2
        },
        "load_full_catalog_into_model_context": {
          "const": false
        }
      }
    },
    "global_boundaries": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "categories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "expected_count"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "development",
              "design",
              "video",
              "writing",
              "translation",
              "marketing",
              "operations",
              "research"
            ]
          },
          "name": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "expected_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "category",
          "name",
          "summary",
          "builtin",
          "price",
          "triggers",
          "exclusions",
          "required_inputs",
          "workflow",
          "deliverables",
          "limitations",
          "permission_boundaries",
          "routing_tags",
          "optional_capabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
            "maxLength": 64
          },
          "version": {
            "const": "1.0.0"
          },
          "category": {
            "enum": [
              "development",
              "design",
              "video",
              "writing",
              "translation",
              "marketing",
              "operations",
              "research"
            ]
          },
          "name": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "summary": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "builtin": {
            "const": true
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "unit"
            ],
            "additionalProperties": false,
            "properties": {
              "amount": {
                "const": 0
              },
              "currency": {
                "const": "USD"
              },
              "unit": {
                "const": "skill_access"
              }
            }
          },
          "triggers": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_inputs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "key",
                "description",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "const": true
                }
              }
            }
          },
          "workflow": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": [
                "step",
                "instruction"
              ],
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1
                },
                "instruction": {
                  "type": "string",
                  "minLength": 40
                }
              }
            }
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "format",
                "acceptance_criteria"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "enum": [
                    "markdown",
                    "json",
                    "code",
                    "text",
                    "csv",
                    "srt_or_vtt"
                  ]
                },
                "acceptance_criteria": {
                  "type": "string",
                  "minLength": 30
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permission_boundaries": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "routing_tags": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "optional_capabilities": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
