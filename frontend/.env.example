# Preview/Production에서는 브라우저가 접근 가능한 HTTPS Spring API URL이 필수입니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_MODEL=
# 분석 화면에서 제공할 모델 목록입니다. 쉼표로 구분하며, 등록되지 않은 제공사는 선택할 수 없습니다.
NEXT_PUBLIC_OPENAI_MODELS=gpt-6-luna,gpt-6-sol,gpt-6.1-sol,gpt-6-astra,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
NEXT_PUBLIC_GEMINI_MODELS=
# 선택값입니다. 검색/공유 대표 URL이며, 미설정 시 아래 공식 주소를 사용합니다.
# Preview의 임시 주소나 localhost를 넣지 마세요.
NEXT_PUBLIC_SITE_URL=https://www.freelance-ops.site
