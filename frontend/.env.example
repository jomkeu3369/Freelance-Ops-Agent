# Preview/Production에서는 브라우저가 접근 가능한 HTTPS Spring API URL이 필수입니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_MODEL=
# 분석 화면에서 제공할 모델 목록입니다. 쉼표로 구분하며, 등록되지 않은 제공사는 선택할 수 없습니다.
NEXT_PUBLIC_OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra
NEXT_PUBLIC_GEMINI_MODELS=
# 선택값입니다. Vercel에서는 미설정 시 VERCEL_URL을 자동 사용합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
