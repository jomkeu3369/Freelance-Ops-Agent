OPENAI_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=freelance-ops-requirements-eval-v1
# LANGSMITH_ENDPOINT=

PROTOTYPE_MODEL=gpt-5.6-terra
PROTOTYPE_REASONING_EFFORT=low
PROTOTYPE_TIMEOUT_SECONDS=90
PROTOTYPE_MAX_RETRIES=2

EVAL_JUDGE_MODEL=gpt-5.6-luna

# JUDGE_COMPLETENESS_MODEL=
# JUDGE_GROUNDEDNESS_MODEL=
# JUDGE_CLARIFICATION_QUALITY_MODEL=

EVAL_JUDGE_REASONING_EFFORT=low
EVAL_TIMEOUT_SECONDS=90
EVAL_MAX_RETRIES=2
EVAL_PASS_THRESHOLD=0.8

# V2 local infrastructure
APP_ENVIRONMENT=development
BACKEND_PORT=8080
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AGENT_DB_PASSWORD=

# V2 provider credentials are injected only into the Agent container.
GEMINI_API_KEY=

# Private route-evaluator prompt values must be supplied by the deployment secret manager.
# Never commit the actual system prompt. Only the approved version/hash may be logged.
AGENT_ROUTE_EVALUATOR_MODEL=gpt-5.6-luna
AGENT_ROUTE_EVALUATOR_REASONING_EFFORT=low
AGENT_ROUTE_EVALUATOR_SYSTEM_PROMPT=
AGENT_ROUTE_EVALUATOR_PROMPT_VERSION=
AGENT_ROUTE_EVALUATOR_PROMPT_SHA256=
AGENT_ROUTE_SHADOW_ENABLED=false

# Agent internal API. Supply the RSA public PEM through the deployment secret manager.
AGENT_DELEGATION_TOKEN_ISSUER=freelance-ops-backend
AGENT_DELEGATION_TOKEN_AUDIENCE=freelance-ops-agent
AGENT_DELEGATION_TOKEN_PUBLIC_KEY=
AGENT_DELEGATION_TOKEN_ALGORITHMS=RS256
AGENT_DELEGATION_TOKEN_LEEWAY_SECONDS=5

# Local Python runs default to memory; Compose and production use PostgreSQL.
AGENT_RUN_STORE_BACKEND=memory
AGENT_CHECKPOINT_BACKEND=memory
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_ATTEMPTS=2
AGENT_RAPTOR_BUILD_TIMEOUT_SECONDS=300
