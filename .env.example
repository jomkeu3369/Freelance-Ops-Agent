OPENAI_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=freelance-ops-requirements-eval-v1
# LANGSMITH_ENDPOINT=

PROTOTYPE_MODEL=gpt-5.6-terra
PROTOTYPE_REASONING_EFFORT=low
PROTOTYPE_TIMEOUT_SECONDS=90
PROTOTYPE_MAX_RETRIES=2

EVAL_JUDGE_MODEL=gpt-5.6-luna

# JUDGE_COMPLETENESS_MODEL=
# JUDGE_GROUNDEDNESS_MODEL=
# JUDGE_CLARIFICATION_QUALITY_MODEL=

EVAL_JUDGE_REASONING_EFFORT=low
EVAL_TIMEOUT_SECONDS=90
EVAL_MAX_RETRIES=2
EVAL_PASS_THRESHOLD=0.8

# V2 local infrastructure
APP_ENVIRONMENT=development
BACKEND_PORT=8080
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AGENT_DB_PASSWORD=

# V2 provider credentials are injected only into the Agent container.
GEMINI_API_KEY=
