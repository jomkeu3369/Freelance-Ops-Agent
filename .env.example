# Compose는 environment에 명시한 값만 컨테이너에 전달한다.
# 서비스를 직접 실행할 때는 필요한 값을 해당 프로세스의 환경 변수로 설정한다.

# 모델 호출과 선택적 추적
OPENAI_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=freelance-ops-agent
# LANGSMITH_ENDPOINT=

# 로컬 서비스와 PostgreSQL
APP_ENVIRONMENT=development
BACKEND_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AGENT_DB_PASSWORD=
DB_POOL_CONNECTION_TIMEOUT_MS=
DB_POOL_VALIDATION_TIMEOUT_MS=
DB_SOCKET_TIMEOUT_SECONDS=
DB_CONNECT_TIMEOUT_SECONDS=

# Spring 사용자 인증. 운영 JWT 비밀값은 32바이트 이상의 무작위 값으로 설정한다.
# 운영 Compose는 JWT 비밀값을 전달하며 나머지는 Spring 기본값을 사용한다.
APP_AUTH_ISSUER=freelance-ops-backend
APP_AUTH_AUDIENCE=freelance-ops-web
APP_AUTH_JWT_SECRET=
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
APP_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# 단일 인스턴스의 요청 제한
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_PER_MINUTE=20
APP_RATE_LIMIT_PUBLIC_PROPOSAL_PER_MINUTE=30
APP_RATE_LIMIT_AGENT_PER_MINUTE=20
APP_RATE_LIMIT_MAX_ENTRIES=10000

# Agent의 선택적 웹 조사. 제공사 키는 Agent에만 전달한다.
TAVILY_API_KEY=
# 펫 대화의 등록된 공식 기술 문서 직접 조회. 일반 웹 검색과 별도이며 개인 키 실행에서는 차단한다.
CONVERSATION_DOCUMENTATION_ENABLED=true
AGENT_WEB_RESEARCH_ENABLED=false
AGENT_WEB_RESEARCH_ALLOWED_DOMAINS=
AGENT_WEB_RESEARCH_MAX_RESULTS=5
AGENT_WEB_RESEARCH_MAX_FETCHES=3
AGENT_WEB_RESEARCH_TIMEOUT_SECONDS=30

# Spring이 적용하는 Agent 실행 한도
AGENT_QUOTA_MAX_DURATION_SECONDS=180
AGENT_QUOTA_MAX_MODEL_CALLS=50
AGENT_QUOTA_MAX_TOOL_CALLS=12
AGENT_QUOTA_MAX_INPUT_TOKENS=150000
AGENT_QUOTA_MAX_OUTPUT_TOKENS=48000
AGENT_QUOTA_MAX_SEARCH_CREDITS=2

# 플랫폼 비용 실행은 기본 차단한다. 활성화할 때도 승인된 USD 예산과 모델별 상한을 유지한다.
# 운영 환경 파일을 바꾼 뒤 Backend를 재생성해야 적용된다.
PLATFORM_AI_SPEND_ENABLED=false

# 경로 판정용 비공개 프롬프트는 배포 비밀 저장소에서 주입한다.
# 원문은 커밋하거나 기록하지 않고 승인된 버전과 해시만 기록한다.
AGENT_ROUTE_EVALUATOR_MODEL=gpt-5.6-luna
AGENT_ROUTE_EVALUATOR_REASONING_EFFORT=low
AGENT_ROUTE_EVALUATOR_SYSTEM_PROMPT=
AGENT_ROUTE_EVALUATOR_PROMPT_VERSION=
AGENT_ROUTE_EVALUATOR_PROMPT_SHA256=

# Spring이 RSA 개인 키로 서명하고 Agent와 Spring Tool이 공개 키로 검증한다.
# 두 PEM 값은 배포 비밀 저장소에서 주입하며 실제 키는 커밋하지 않는다.
AGENT_DELEGATION_TOKEN_ISSUER=freelance-ops-backend
AGENT_DELEGATION_TOKEN_AGENT_AUDIENCE=freelance-ops-agent
AGENT_DELEGATION_TOKEN_TOOL_AUDIENCE=freelance-ops-spring-tools
AGENT_DELEGATION_TOKEN_KEY_ID=freelance-ops-v1
AGENT_DELEGATION_TOKEN_PREVIOUS_KEY_ID=
AGENT_DELEGATION_TOKEN_PREVIOUS_PUBLIC_KEY=
AGENT_DELEGATION_TOKEN_TTL_SECONDS=60
AGENT_DELEGATION_TOKEN_PRIVATE_KEY=
AGENT_DELEGATION_TOKEN_PUBLIC_KEY=
AGENT_DELEGATION_TOKEN_ALGORITHMS=RS256

# 직접 실행하는 Agent의 위임 토큰 허용 오차·저장소·모델 요청 제한
# Compose는 실행 저장소와 체크포인트를 PostgreSQL로 고정한다.
AGENT_DELEGATION_TOKEN_LEEWAY_SECONDS=5
AGENT_RUN_STORE_BACKEND=memory
AGENT_CHECKPOINT_BACKEND=memory
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_ATTEMPTS=2

# 모델 호출 동시 실행·장애 차단과 내부 지표
AGENT_GATEWAY_MAX_CONCURRENCY=2
AGENT_GATEWAY_ACQUIRE_TIMEOUT_SECONDS=2
AGENT_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_GATEWAY_CIRCUIT_RECOVERY_SECONDS=30
# 쉼표로 구분한 모델 허용 목록. 비어 있으면 Spring이 선택한 모델을 받는다.
AGENT_GATEWAY_ALLOWED_MODELS=
AGENT_GATEWAY_METRICS_ENABLED=false
AGENT_GATEWAY_METRICS_BEARER_TOKEN=
# RAPTOR 제한을 조정하려면 Agent 프로세스에 직접 전달한다.
AGENT_RAPTOR_BUILD_TIMEOUT_SECONDS=300

# 직접 실행하는 Agent의 경로·작업 관측과 제한된 FIFO 실험. 기본 Compose에는 전달하지 않는다.
AGENT_ROUTE_SHADOW_ENABLED=false
AGENT_TASK_SHADOW_ENABLED=false
AGENT_FIFO_DISPATCHER_ENABLED=false
AGENT_FIFO_DISPATCHER_RESOURCE_POOL=research-read-v1
AGENT_FIFO_DISPATCHER_CLAIMED_BY=agent-research-dispatcher
AGENT_FIFO_DISPATCHER_LEASE_SECONDS=60
AGENT_FIFO_DISPATCHER_PREDICTED_RUNTIME_SECONDS=30
AGENT_FIFO_DISPATCHER_PREDICTOR_VERSION=pilot-static-v1
AGENT_FIFO_DISPATCHER_WORKER_COUNT=1
AGENT_FIFO_DISPATCHER_WORKSPACE_ALLOWLIST=

# 개인 AI 키 암호화에 쓸 전용 32바이트 키의 base64 값. 운영 배포에서 최초 한 번 준비한다.
# 비공개 백업에 별도 보존하고 암묵적으로 교체하지 않는다.
APP_BYOK_ENCRYPTION_KEY=
APP_BYOK_OPENAI_MODELS=

# Backend와 Agent는 같은 임베딩 모델을 사용한다.
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_SUMMARY_MODEL=gpt-5.6-luna

# 운영 도메인과 이미지. 태그는 배포할 때 지정한다.
APP_DOMAIN=
BACKEND_IMAGE=ghcr.io/your-account/freelance-ops-backend
AGENT_IMAGE=ghcr.io/your-account/freelance-ops-agent
BACKEND_IMAGE_TAG=
AGENT_IMAGE_TAG=

# 백업 스크립트를 실행할 셸에서 암호화된 외부 rclone 경로를 설정한다.
BACKUP_REMOTE=
